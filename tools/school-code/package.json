{
  "name": "koreatech-school-code",
  "displayName": "KOREATECH School Code",
  "description": "학교 AI 채팅과 승인 기반 개발 도구를 VS Code에서 사용합니다.",
  "version": "0.18.2",
  "publisher": "skylight-local",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkylightStudio07/koreatech-lxp-image-gen.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Machine Learning"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:schoolCode.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "schoolCode.open",
        "title": "School Code: 채팅 열기"
      },
      {
        "command": "schoolCode.connect",
        "title": "School Code: 학교 브라우저 연결"
      },
      {
        "command": "schoolCode.relay",
        "title": "School Code: 외부 MCP 중계 연결"
      },
      {
        "command": "schoolCode.repairRelay",
        "title": "School Code: 토큰 재발급 (문제 해결)"
      },
      {
        "command": "schoolCode.copyMcpAuth",
        "title": "School Code: 학교 MCP 인증 JSON 복사"
      },
      {
        "command": "schoolCode.disconnectRelay",
        "title": "School Code: 외부 MCP 연결 해제"
      },
      {
        "command": "schoolCode.mcpCatalog",
        "title": "School Code: MCP 카탈로그 열기"
      },
      {
        "command": "schoolCode.mcpAdd",
        "title": "School Code: MCP 추가"
      },
      {
        "command": "schoolCode.openMcpCatalog",
        "title": "School Code: MCP 카탈로그 사이트 열기"
      },
      {
        "command": "schoolCode.notionConfigure",
        "title": "School Code: Notion 연결 설정"
      },
      {
        "command": "schoolCode.notionDisconnect",
        "title": "School Code: Notion 연결 해제"
      },
      {
        "command": "schoolCode.unityConfigure",
        "title": "School Code: Unity CLI 경로 설정"
      },
      {
        "command": "schoolCode.unityEditorConfigure",
        "title": "School Code: Unity Editor 자동 준비"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "schoolCode",
          "title": "School Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "schoolCode": [
        {
          "type": "webview",
          "id": "schoolCode.chat",
          "name": "학교 AI"
        }
      ]
    },
    "configuration": {
      "title": "School Code",
      "properties": {
        "schoolCode.bridgePort": {
          "type": "number",
          "default": 18766,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "브라우저 연결용 loopback 포트. 변경 후 창을 다시 로드하세요."
        },
        "schoolCode.relayUrl": {
          "type": "string",
          "default": "https://bcsd-nai.mywire.org:3010",
          "scope": "application",
          "description": "외부 MCP 중계 서버 HTTPS 주소. 로컬 테스트는 http://127.0.0.1:18880"
        },
        "schoolCode.mcpCatalogUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "원클릭 MCP 카탈로그 사이트 주소. 비워 두면 확장 내 카탈로그를 사용합니다."
        },
        "schoolCode.unityExecutable": {
          "type": "string",
          "default": "Unity.exe",
          "scope": "machine",
          "description": "Unity CLI 실행 파일 경로. 셸 도구는 별도 승인 후 연결된 프로젝트 안에서 실행합니다."
        },
        "schoolCode.unityEditorPort": {
          "type": "number",
          "default": 18777,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Unity Editor 로컬 MCP 브리지 포트"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test test/*.test.cjs",
    "relay": "node dist/relay.cjs",
    "keys": "node scripts/keys.cjs",
    "package": "node scripts/package.cjs",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  }
}
